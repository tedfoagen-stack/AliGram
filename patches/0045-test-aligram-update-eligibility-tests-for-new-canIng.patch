+                true, true, true, true, false, true, true, true, false,
                 false, A + 1, A, AliGramEligibility.ActivationState.STAMPED, false));
         assertFalse(AliGramEligibility.canIngest(
-                true, true, true, true, false, false, true, false, true, false,
