From 10c98bfd160915a30608459a3e4a57bb04ccc833 Mon Sep 17 00:00:00 2001
From: tedfoagen-stack <tedfoagen@gmail.com>
Date: Sat, 21 Nov 2026 17:18:51 +0300
Subject: [PATCH 48/67] build(aligram): versionCode 1260 -> 1261, CI signing
 secrets take precedence for release key

---
 TMessagesProj/build.gradle | 19 +++++++++----------
 1 file changed, 9 insertions(+), 10 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 09a9870ee..1cca62a96 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -20,7 +20,7 @@ plugins {
 def buildTimestamp = System.getenv('BUILD_TIMESTAMP') ?: '0'
 def commitId = System.getenv('COMMIT_ID')
 def verName = "${APP_VERSION_NAME}${commitId?.take(7) ? "-${commitId.take(7)}" : ''}"
-def verCode = 1260
+def verCode = 1261
 
 def officialVer = APP_VERSION_NAME
 def officialCode = APP_VERSION_CODE
@@ -39,15 +39,14 @@ if (base64 != null && !base64.isBlank()) {
     properties.load(project.rootProject.file('local.properties').newDataInputStream())
 }
 
-if (properties != null) {
-    keystorePwd = properties.getProperty('KEYSTORE_PASS')
-    alias = properties.getProperty('ALIAS_NAME')
-    pwd = properties.getProperty('ALIAS_PASS')
-}
-
-keystorePwd = keystorePwd ?: System.getenv('KEYSTORE_PASS')
-alias = alias ?: System.getenv('ALIAS_NAME')
-pwd = pwd ?: System.getenv('ALIAS_PASS')
+// AliGram release signing (2026-11-21): CI secrets KEYSTORE_PASS /
+// ALIAS_NAME / ALIAS_PASS take precedence over LOCAL_PROPERTIES, which
+// may still hold upstream's key passwords. The keystore itself comes
+// from the RELEASE_KEYSTORE_BASE64 CI secret, decoded by the workflow
+// to TMessagesProj/release.keystore (CI workspace only, never committed).
+keystorePwd = System.getenv('KEYSTORE_PASS') ?: (properties != null ? properties.getProperty('KEYSTORE_PASS') : null)
+alias = System.getenv('ALIAS_NAME') ?: (properties != null ? properties.getProperty('ALIAS_NAME') : null)
+pwd = System.getenv('ALIAS_PASS') ?: (properties != null ? properties.getProperty('ALIAS_PASS') : null)
 
 def nativeTarget = System.getenv('NATIVE_TARGET') ?: ''
 
-- 
2.43.0

