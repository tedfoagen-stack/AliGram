+    // --- AliGram hidden folders: lock-state refresh + timers. ---
+
+    /** Lock state last seen by onResume; detects a lock that happened while paused (background lock, auto-lock timer). */
+    private boolean aliGramWasUnlocked;
+    /** UI-side auto-lock refresh, scheduled at unlock; fires when the core 1-hour timer expires. */
+    private Runnable aliGramAutoLockRefreshRunnable;
+    /** Delayed clear of a ## setup candidate after the debounced commit. */
+    private Runnable aliGramSetupClearRunnable;
+
+    /**
+     * Refreshes every display surface after a lock/unlock/hide/unhide
+     * transition: rebuilds the hidden-dialog cache and the per-filter dialog
+     * lists, moves off a now-hidden current tab, rebuilds the tabs and
+     * reloads the lists/counters. Also (re)schedules the UI-side auto-lock
+     * refresh while unlocked.
+     */
+    private void aliGramRefreshAfterLockChange() {
+        getMessagesController().refreshAliGramHiddenFolders();
+        getMessagesController().sortDialogs(null);
+        if (viewPages != null && viewPages.length > 0 && viewPages[0] != null && filterTabsView != null) {
+            int selectedType = viewPages[0].selectedType;
+            ArrayList<MessagesController.DialogFilter> filters = getMessagesController().getDialogFilters();
+            if (selectedType >= 0 && selectedType < filters.size()
+                    && !AliGramHiddenFolders.isUnlocked(currentAccount)
+                    && AliGramHiddenFolders.isFilterHidden(currentAccount, filters.get(selectedType).id)) {
+                viewPages[0].selectedType = filterTabsView.getDefaultTabId();
+                filterTabsView.selectTabWithStableId(filterTabsView.getStableId(0));
+            }
+        }
+        updateFilterTabs(true, false);
+        NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.dialogsNeedReload, true);
+        aliGramScheduleAutoLockRefresh();
+    }
+
+    /** Schedules a UI refresh for when the 1-hour auto-lock expires. The core owns the lock itself; this only refreshes the UI. Cancelled on pause (backgrounding locks via LaunchActivity.onStop, and onResume re-checks). */
+    private void aliGramScheduleAutoLockRefresh() {
+        aliGramCancelAutoLockRefresh();
+        if (!AliGramHiddenFolders.isUnlocked(currentAccount)) {
+            return;
+        }
+        long remaining = AliGramHiddenFolders.getUnlockStartedAt(currentAccount) + AliGramHiddenFolders.AUTO_LOCK_MS - System.currentTimeMillis();
+        if (remaining <= 0) {
+            AliGramHiddenFolders.lock(currentAccount);
+            aliGramRefreshAfterLockChange();
+            return;
+        }
+        aliGramAutoLockRefreshRunnable = () -> {
+            aliGramAutoLockRefreshRunnable = null;
+            if (!AliGramHiddenFolders.isUnlocked(currentAccount)) {
+                aliGramRefreshAfterLockChange();
+            } else {
+                aliGramScheduleAutoLockRefresh();
+            }
+        };
+        AndroidUtilities.runOnUIThread(aliGramAutoLockRefreshRunnable, remaining);
+    }
+
+    private void aliGramCancelAutoLockRefresh() {
+        if (aliGramAutoLockRefreshRunnable != null) {
+            AndroidUtilities.cancelRunOnUIThread(aliGramAutoLockRefreshRunnable);
+            aliGramAutoLockRefreshRunnable = null;
+        }
+    }
+
+    /** Clears a ## setup candidate from the search field shortly after the core's debounced commit, so the code does not stay visible. Re-scheduled on every keystroke, in step with the core debounce. */
+    private void aliGramScheduleSetupClear(EditText editText, String text) {
+        aliGramCancelSetupClear();
+        final String candidate = text;
+        aliGramSetupClearRunnable = () -> {
+            aliGramSetupClearRunnable = null;
+            try {
+                if (editText.getText() != null && candidate.equals(editText.getText().toString())) {
+                    editText.getText().clear();
+                }
+            } catch (Exception ignore) {
+            }
+        };
+        AndroidUtilities.runOnUIThread(aliGramSetupClearRunnable, AliGramHiddenFolders.SETUP_DEBOUNCE_MS + 100);
+    }
+
+    private void aliGramCancelSetupClear() {
+        if (aliGramSetupClearRunnable != null) {
+            AndroidUtilities.cancelRunOnUIThread(aliGramSetupClearRunnable);
+            aliGramSetupClearRunnable = null;
+        }
+    }
+
