+                // --- AliGram hidden folders: display-level unread
+                // subtraction. The stored counts (mainUnreadCount /
+                // DialogFilter.unreadCount) come from MessagesStorage
+                // calcUnreadCounters, which is deliberately untouched; the
+                // hidden dialogs' unread is subtracted here instead. The
+                // mute/archive flag mirrors are the same ones
+                // calcUnreadCounters applies to each bucket.
+                private int aliGramSubtractHiddenUnread(int total, MessagesController.DialogFilter filter) {
+                    if (total <= 0 || AliGramHiddenFolders.hiddenFilterIds(currentAccount).isEmpty()) {
+                        return total;
+                    }
+                    boolean excludeMuted;
+                    if (filter == null) {
+                        excludeMuted = !getNotificationsController().showBadgeMuted;
+                    } else {
+                        excludeMuted = (filter.flags & MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_MUTED) != 0
+                                || NaConfig.INSTANCE.getIgnoreUnreadCount().Int() == NekoConfig.DIALOG_FILTER_EXCLUDE_MUTED;
+                    }
+                    int hiddenUnread = 0;
+                    ArrayList<TLRPC.Dialog> allDialogs = getMessagesController().getAllDialogs();
+                    for (int i = 0, n = allDialogs.size(); i < n; i++) {
+                        TLRPC.Dialog d = allDialogs.get(i);
+                        if (d == null || !AliGramHiddenFolders.isDialogHidden(currentAccount, d.id)) {
+                            continue;
+                        }
+                        if (filter == null) {
+                            if (d.folder_id != 0) {
+                                continue;
+                            }
+                        } else {
+                            if ((filter.flags & MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_ARCHIVED) != 0 && d.folder_id == 1) {
+                                continue;
+                            }
+                            if (!filter.includesDialog(getAccountInstance(), d.id, d)) {
+                                continue;
+                            }
+                        }
+                        if (excludeMuted && getMessagesController().isDialogMuted(d.id)) {
+                            continue;
+                        }
+                        hiddenUnread += getMessagesController().getDialogUnreadCount(d);
+                    }
+                    return Math.max(0, total - hiddenUnread);
                 }
 
