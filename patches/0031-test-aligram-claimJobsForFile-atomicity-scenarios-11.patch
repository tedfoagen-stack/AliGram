index fe64fc7e4..14929221b 100644
--- a/TMessagesProj/src/test/java/com/radolyn/ayugram/aligram/AliGramRoomIntegrationTest.java
+++ b/TMessagesProj/src/test/java/com/radolyn/ayugram/aligram/AliGramRoomIntegrationTest.java
@@ -1003,4 +1003,310 @@ public class AliGramRoomIntegrationTest {
             }
         }
