@@ -0,0 +1,45 @@
+package com.radolyn.ayugram.aligram;
+
+import androidx.room.Entity;
+import androidx.room.Index;
+import androidx.room.PrimaryKey;
+
+/**
+ * One row per distinct media blob (content-addressed, refcounted).
+ * Phase 2.2 §6.2. The file on disk is named {@code <blobId>.<ext>} under
+ * {@code <getNoBackupFilesDir()>/aligram/[account<N>/]blobs/}; it is
+ * deleted only when {@code refCount} reaches 0, never by mediaPath.
+ */
+@Entity(
+        tableName = "PreservedBlob",
+        indices = {
+                @Index(value = {"documentId", "dcId", "size"}),
+                @Index(value = {"sha256"})
+        }
+)
+public class PreservedBlob {
+    /** "d<documentId>_<dcId>_<size>_<sha16>" or "p<photoId>_…" (see AliGramEligibility.blobIdFor). */
+    @PrimaryKey
+    public String blobId;
+    /** 0 when photo. */
+    public long documentId;
+    /** 0 when document. */
+    public long photoId;
+    public int dcId;
+    /** Bytes, actual copied size. */
+    public long size;
+    /** Full hex SHA-256, computed during the copy stream (single pass). */
+    public String sha256;
+    public String mimeType;
+    public String ext;
+    /** Deterministic file name: {@code <blobId>.<ext>}. */
+    public String fileName;
+    /** User-facing name at freeze time (for render display). */
+    public String originalFileName;
+    /** 0 when not a photo (render needs dimensions; blob names carry none). */
+    public int photoWidth;
+    public int photoHeight;
+    /** Number of PreservedRef rows pointing here; file deleted only at 0. */
+    public int refCount;
+    public long createdAt;
+}
diff --git a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedBlobDao.java b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedBlobDao.java
new file mode 100644
index 000000000..26153f712
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedBlobDao.java
@@ -0,0 +1,51 @@
+package com.radolyn.ayugram.aligram;
+
+import androidx.room.Dao;
+import androidx.room.Insert;
+import androidx.room.OnConflictStrategy;
+import androidx.room.Query;
+
+import java.util.List;
+
+/** DAO for {@link PreservedBlob}. Dedupe happens at copy time: if a blob
+ *  with the same (documentId|photoId, dcId, size, sha256) already exists,
+ *  the temp copy is discarded and the existing blob is reused (refcount+1). */
+@Dao
+public interface PreservedBlobDao {
+
+    @Insert(onConflict = OnConflictStrategy.IGNORE)
+    long insertBlob(PreservedBlob blob);
+
+    @Query("SELECT * FROM PreservedBlob WHERE documentId = :documentId AND dcId = :dcId AND size = :size")
+    List<PreservedBlob> getBlobsByDocument(long documentId, int dcId, long size);
+
+    @Query("SELECT * FROM PreservedBlob WHERE photoId = :photoId AND dcId = :dcId AND size = :size")
+    List<PreservedBlob> getBlobsByPhoto(long photoId, int dcId, long size);
+
+    @Query("SELECT * FROM PreservedBlob WHERE blobId = :blobId LIMIT 1")
+    PreservedBlob getById(String blobId);
+
+    @Query("SELECT * FROM PreservedBlob WHERE documentId = :documentId AND dcId = :dcId AND size = :size AND sha256 = :sha256 LIMIT 1")
+    PreservedBlob getByDocumentKey(long documentId, int dcId, long size, String sha256);
+
+    @Query("SELECT * FROM PreservedBlob WHERE photoId = :photoId AND dcId = :dcId AND size = :size AND sha256 = :sha256 LIMIT 1")
+    PreservedBlob getByPhotoKey(long photoId, int dcId, long size, String sha256);
+
+    @Query("UPDATE PreservedBlob SET refCount = refCount + 1 WHERE blobId = :blobId")
+    void incrementRefCount(String blobId);
+
+    @Query("UPDATE PreservedBlob SET refCount = refCount - 1 WHERE blobId = :blobId")
+    void decrementRefCount(String blobId);
+
+    @Query("SELECT * FROM PreservedBlob WHERE refCount <= 0")
+    List<PreservedBlob> getOrphanBlobs();
+
+    @Query("DELETE FROM PreservedBlob WHERE blobId = :blobId")
+    void deleteById(String blobId);
+
+    @Query("SELECT COUNT(*) FROM PreservedBlob")
+    int countBlobs();
+
+    @Query("SELECT COALESCE(SUM(size), 0) FROM PreservedBlob")
+    long totalBytes();
+}
diff --git a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedRef.java b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedRef.java
new file mode 100644
index 000000000..0ffd352ae
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedRef.java
@@ -0,0 +1,88 @@
+package com.radolyn.ayugram.aligram;
+
+import androidx.room.Entity;
+import androidx.room.Index;
+import androidx.room.PrimaryKey;
+
+/**
+ * AliGram preservation job row. This row IS the job (Phase 2.2 §6.3,
+ * corrected by Phase 2.3 §2.2): identity is carried end to end by this row,
+ * never by a notification payload or a parent-object parse.
+ *
+ * <p>Identity: exact join key is {@code ayuFakeId} (EditedMessage /
+ * DeletedMessage Room PK) + {@code revisionSeq} (monotonic per message,
+ * EDIT rows only; LIVE rows are 0). {@code entityCreateDate} is display
+ * only, never a join key. Pin columns ({@code sourcePath/sourceSize/
+ * sourceMtime}) are the Phase 2.3 §2.2(b) addition: the durable pin
+ * registry consulted by the deferred-delete guards.
+ */
+@Entity(
+        tableName = "PreservedRef",
+        indices = {
+                @Index(value = {"userId", "dialogId", "messageId", "role", "revisionSeq"}, unique = true),
+                @Index(value = {"ayuFakeId"}),
+                @Index(value = {"accountId", "expectedFileName"}),
+                @Index(value = {"sourcePath"}),
+                @Index(value = {"userId", "dialogId", "messageId", "entityCreateDate"})
+        }
+)
+public class PreservedRef {
+    @PrimaryKey(autoGenerate = true)
+    public long refId;
+
+    /** Own account user id (multi-account key). */
+    public long userId;
+    public int accountId;
+    /** Raw signed dialog id, never abs(). */
+    public long dialogId;
+    public int messageId;
+    /** "LIVE" | "DELETED" | "EDIT". */
+    public String role;
+    /** Monotonic per (userId, dialogId, messageId), EDIT rows only (LIVE: 0). */
+    public int revisionSeq;
+    /** EditedMessage/DeletedMessage.fakeId when known, else 0. THE join key. */
+    public long ayuFakeId;
+    /** Copied from the Ayu row. Display + fallback discriminator only. */
+    public int entityCreateDate;
+    /** oldMessage.edit_date (server seconds; 0 for the original). */
+    public int editDate;
+    /** SHA-256 of (old text + textEntities bytes), nullable. */
+    public String textHash;
+    /** Media identity captured at freeze/ingest time. */
+    public long documentId;
+    public long photoId;
+    public int dcId;
+    /** FK to PreservedBlob, null until copied. */
+    public String blobId;
+    /** ENQUEUED | DOWNLOADING | PINNED | COPYING | COPIED | FAILED |
+     *  UNAVAILABLE | CANCELLED | GATE_OFF | SWEPT. */
+    public String state;
+    /** FileLoader attach name, derived ONCE from the exact object passed to loadFile. */
+    public String expectedFileName;
+    /** Bytes, 0 when unknown (photo size-variant estimate). */
+    public long expectedSize;
+    /** Failure counter for the attempts-budget rule (3 → FAILED). */
+    public int attempts;
+    /** Nullable; one terminal vocabulary (see AliGramEligibility reasons). */
+    public String lastError;
+    /** Which gate went off, for GATE_OFF rows (P / D / E). */
+    public String gateName;
+    /** "INGEST" | "EDIT_FREEZE" | "LIVE_SYNC". Diagnostics + policy. */
+    public String source;
+    public long updatedAt;
+
+    // --- Durable pin registry (Phase 2.3 §2.2(b)) ---
+    /** Absolute path of the pinned cache file. */
+    public String sourcePath;
+    public long sourceSize;
+    public long sourceMtime;
+    /** Pending-delete file names recorded at pin time (crash-recovery seed). */
+    public String pendingDeletePaths;
+    /** True when the in-flight download's cancel was deferred to release time. */
+    public boolean cancelDeferred;
+
+    // --- Media display facts carried on the ref (render needs them) ---
+    public String originalFileName;
+    public int photoWidth;
+    public int photoHeight;
+}
diff --git a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedRefDao.java b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedRefDao.java
new file mode 100644
index 000000000..178dbee81
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/PreservedRefDao.java
@@ -0,0 +1,110 @@
+package com.radolyn.ayugram.aligram;
+
+import androidx.room.Dao;
+import androidx.room.Insert;
+import androidx.room.OnConflictStrategy;
+import androidx.room.Query;
+import androidx.room.Transaction;
+import androidx.room.Update;
+
+import java.util.List;
+
+/** DAO for {@link PreservedRef}. All calls are synchronous; call only from
+ *  background threads (storage queue / globalQueue / copy queue /
+ *  fileLoaderQueue) — never from the UI thread. */
+@Dao
+public interface PreservedRefDao {
+
+    @Insert
+    long insertRef(PreservedRef ref);
+
+    @Update
+    void updateRef(PreservedRef ref);
+
+    @Query("SELECT * FROM PreservedRef WHERE refId = :refId LIMIT 1")
+    PreservedRef getRefById(long refId);
+
+    @Query("SELECT * FROM PreservedRef")
+    List<PreservedRef> getAllRefs();
+
+    @Query("SELECT * FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId")
+    List<PreservedRef> getRefsForDialog(long userId, long dialogId);
+
+    @Query("SELECT * FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND messageId = :messageId AND role = 'LIVE' LIMIT 1")
+    PreservedRef getLiveRef(long userId, long dialogId, int messageId);
+
+    @Query("SELECT * FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND messageId = :messageId AND role = :role AND revisionSeq = :revisionSeq LIMIT 1")
+    PreservedRef getRef(long userId, long dialogId, int messageId, String role, int revisionSeq);
+
+    @Query("SELECT * FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND messageId = :messageId")
+    List<PreservedRef> getRefsForMessage(long userId, long dialogId, int messageId);
+
+    @Query("SELECT * FROM PreservedRef WHERE ayuFakeId = :ayuFakeId AND ayuFakeId != 0 LIMIT 1")
+    PreservedRef getRefByAyuFakeId(long ayuFakeId);
+
+    @Query("SELECT * FROM PreservedRef WHERE ayuFakeId = :ayuFakeId AND ayuFakeId != 0 AND role = :role LIMIT 1")
+    PreservedRef getRefByAyuFakeIdAndRole(long ayuFakeId, String role);
+
+    /** Waiting rows for one completion event (fan-out claim source). */
+    @Query("SELECT * FROM PreservedRef WHERE accountId = :accountId AND expectedFileName = :expectedFileName AND state IN ('ENQUEUED', 'DOWNLOADING', 'PINNED')")
+    List<PreservedRef> getWaitingJobsForFile(int accountId, String expectedFileName);
+
+    /** Active pins covering one source path (Layer-1/Layer-2 guard + release check). */
+    @Query("SELECT * FROM PreservedRef WHERE sourcePath = :sourcePath AND state IN ('PINNED', 'COPYING', 'DOWNLOADING', 'ENQUEUED')")
+    List<PreservedRef> getActivePinsForPath(String sourcePath);
+
+    @Query("SELECT * FROM PreservedRef WHERE state = 'PINNED'")
+    List<PreservedRef> getPinnedRefs();
+
+    @Query("SELECT * FROM PreservedRef WHERE state IN ('ENQUEUED', 'DOWNLOADING', 'COPYING', 'PINNED')")
+    List<PreservedRef> getNonTerminalRefs();
+
+    @Query("SELECT * FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND state IN ('ENQUEUED', 'DOWNLOADING', 'COPYING')")
+    List<PreservedRef> getPendingJobsForDialog(long userId, long dialogId);
+
+    @Query("SELECT COUNT(*) FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND state IN ('ENQUEUED', 'DOWNLOADING', 'COPYING')")
+    int getPendingJobCountForDialog(long userId, long dialogId);
+
+    @Query("SELECT COALESCE(SUM(expectedSize), 0) FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND state IN ('ENQUEUED', 'DOWNLOADING', 'COPYING')")
+    long getPendingBytesForDialog(long userId, long dialogId);
+
+    @Query("SELECT COALESCE(MAX(revisionSeq), 0) FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId AND messageId = :messageId AND role = 'EDIT'")
+    int getMaxEditRevisionSeq(long userId, long dialogId, int messageId);
+
+    @Query("SELECT * FROM PreservedRef WHERE accountId = :accountId AND state IN ('ENQUEUED', 'DOWNLOADING', 'COPYING', 'PINNED')")
+    List<PreservedRef> getActiveRefsForAccount(int accountId);
+
+    @Query("SELECT COUNT(*) FROM PreservedRef WHERE blobId = :blobId")
+    int countRefsForBlob(String blobId);
+
+    @Query("DELETE FROM PreservedRef WHERE refId = :refId")
+    void deleteRefById(long refId);
+
+    @Query("DELETE FROM PreservedRef WHERE userId = :userId")
+    void deleteRefsForAccount(long userId);
+
+    @Query("DELETE FROM PreservedRef WHERE userId = :userId AND dialogId = :dialogId")
+    void deleteRefsForDialog(long userId, long dialogId);
+
+    /**
+     * Fan-out claim (Phase 2.2 §1.7): move every waiting row for one file to
+     * COPYING in a single transaction; the caller then copies once and binds
+     * per job. A second delivery finds no waiting rows and is a no-op.
+     */
+    @Transaction
+    default List<PreservedRef> claimJobsForFile(int accountId, String expectedFileName) {
+        List<PreservedRef> jobs = getWaitingJobsForFile(accountId, expectedFileName);
+        for (PreservedRef job : jobs) {
+            job.state = AliGramEligibility.STATE_COPYING;
+            job.updatedAt = System.currentTimeMillis() / 1000;
+            updateRef(job);
+        }
+        return jobs;
+    }
+
+    /** Next EDIT revisionSeq for a message, assigned in one transaction. */
+    @Transaction
+    default int nextRevisionSeq(long userId, long dialogId, int messageId) {
+        return AliGramEligibility.nextRevisionSeq(getMaxEditRevisionSeq(userId, dialogId, messageId));
+    }
+}
