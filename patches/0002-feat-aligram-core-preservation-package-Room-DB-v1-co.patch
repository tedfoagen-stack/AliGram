+            long channelId = message.peer_id != null ? message.peer_id.channel_id : 0;
+            return "sent_" + channelId + "_" + message.id + "_"
+                    + DialogObject.getPeerDialogId(message.peer_id) + "_"
+                    + messageObject.type + "_" + messageObject.getSize();
