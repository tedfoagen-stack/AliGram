From 94c669105f56e571b0e45a54c57f3e21bbe2e63b Mon Sep 17 00:00:00 2001
From: AliGram <aligram@local>
Date: Sun, 15 Nov 2026 18:18:04 +0000
Subject: [PATCH 39/67] =?UTF-8?q?feat(aligram):=20FCM=20via=20CI=20secret?=
 =?UTF-8?q?=20(R1)=20=E2=80=94=20re-apply=20google-services=20plugin?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- TMessagesProj/build.gradle: re-apply `id 'com.google.gms.google-services'`
  (v4.5.0 already declared in root build.gradle, apply false). The plugin
  reads TMessagesProj/google-services.json and generates the Firebase
  resources for app.aligram.
- .github/workflows/aligram-build.yml: new step before Unit Tests writes
  secrets.GOOGLE_SERVICES_JSON to TMessagesProj/google-services.json,
  fails fast if the secret is empty, and validates the JSON (single client,
  package_name == app.aligram) without printing any values.

The json is NEVER committed: the committed file stays upstream's
(nu.gpu.nagram, project nagram-x); CI overwrites it at build time with
Ali's app.aligram client (project aligram-41bad).

No other change: no duplicate Firebase SDK, no version changes,
Crashlytics stays off (shouldEnableCrashlytics() == false), no API
ID/Hash, applicationId, keep-alive or push-provider changes.
Requires the GOOGLE_SERVICES_JSON repository secret before CI can go
green; build success alone is not FCM success (phone test F1/F2 still
needed later).
---
 .github/workflows/aligram-build.yml | 28 ++++++++++++++++++++++++++++
 TMessagesProj/build.gradle          | 21 +++++++++++----------
 2 files changed, 39 insertions(+), 10 deletions(-)

diff --git a/.github/workflows/aligram-build.yml b/.github/workflows/aligram-build.yml
index 5fcebfa61..5c53c0302 100644
--- a/.github/workflows/aligram-build.yml
+++ b/.github/workflows/aligram-build.yml
@@ -53,6 +53,34 @@ jobs:
             echo "org.gradle.jvmargs=-Xmx8G -XX:MaxMetaspaceSize=2G -XX:+UseParallelGC -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8" >> gradle.properties
           fi
           cat gradle.properties
+      - name: Write google-services.json from CI secret
+        # AliGram R1 (FCM): google-services.json is a GitHub Actions
+        # secret (GOOGLE_SERVICES_JSON), NEVER committed to the repo. The
+        # committed file stays upstream's (nu.gpu.nagram, project
+        # nagram-x); CI overwrites it with Ali's app.aligram client
+        # (project aligram-41bad) before the build, so the google-services
+        # plugin generates the right Firebase resources. Fail fast if the
+        # secret is missing, and validate the JSON without printing any
+        # values (only the package_name assertion is ever shown).
+        env:
+          GOOGLE_SERVICES_JSON: ${{ secrets.GOOGLE_SERVICES_JSON }}
+        run: |
+          set -euo pipefail
+          if [ -z "${GOOGLE_SERVICES_JSON:-}" ]; then
+            echo "FAIL: GOOGLE_SERVICES_JSON secret is empty or missing. Create the repository secret (Settings -> Secrets and variables -> Actions -> GOOGLE_SERVICES_JSON) with the app.aligram google-services.json content, then re-run."
+            exit 1
+          fi
+          printf '%s' "$GOOGLE_SERVICES_JSON" > TMessagesProj/google-services.json
+          python3 - <<'EOF'
+          import json
+          with open("TMessagesProj/google-services.json", encoding="utf-8") as f:
+              data = json.load(f)
+          clients = data.get("client", [])
+          assert len(clients) == 1, "expected exactly 1 client, got %d" % len(clients)
+          pkg = clients[0].get("client_info", {}).get("android_client_info", {}).get("package_name")
+          assert pkg == "app.aligram", "unexpected package_name: %r" % (pkg,)
+          print("OK: google-services.json is valid JSON with a single app.aligram client.")
+          EOF
       - name: Unit Tests
         run: |
           export LOCAL_PROPERTIES="${{ secrets.LOCAL_PROPERTIES }}"
diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index d60ceed33..09a9870ee 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -3,16 +3,17 @@ import org.gradle.internal.os.OperatingSystem
 
 plugins {
     id 'com.android.application'
-    // NOTE (AliGram): the Google Services plugin is intentionally NOT applied.
-    // It reads TMessagesProj/google-services.json and fails the build when no
-    // client matches the applicationId — the upstream file only has a client
-    // for nu.gpu.nagram, and AliGram (app.aligram) has no Firebase project
-    // yet. Do NOT add a fabricated client entry: that would invent Firebase
-    // credentials. Re-apply this plugin only when AliGram has a real Firebase
-    // project and a real google-services.json client for app.aligram.
-    // Until then FCM and Crashlytics mapping upload are inert by design
-    // (Crashlytics collection is already forced off in AndroidUtil, and the
-    // getInstance() call below is guarded against a missing default app).
+    // AliGram R1 (FCM): the Google Services plugin IS applied. It reads
+    // TMessagesProj/google-services.json and generates the Firebase
+    // resources (google_app_id / gcm_defaultSenderId) for app.aligram.
+    // The file is NOT committed to the repo: it comes from the
+    // GOOGLE_SERVICES_JSON GitHub Actions secret (see
+    // .github/workflows/aligram-build.yml), which overwrites the
+    // committed upstream file (nu.gpu.nagram, project nagram-x) at build
+    // time. Crashlytics collection stays forced off in AndroidUtil
+    // (shouldEnableCrashlytics() == false); the getInstance() guard in
+    // ApplicationLoader stays as-is.
+    id 'com.google.gms.google-services'
     id 'com.google.firebase.crashlytics'
 }
 
