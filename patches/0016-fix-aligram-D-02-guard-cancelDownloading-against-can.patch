+                // above, which already re-checks the DAO.
+                boolean stillNeeded = false;
+                if (dao != null) {
+                    List<PreservedRef> active = dao.getActiveRefsForFileName(ref.accountId, ref.expectedFileName);
+                    if (active != null) {
