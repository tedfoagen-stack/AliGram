Verified: pendingLoads is process-local (empty after restart) and the
pin stores only identity (documentId/photoId/dcId/expectedFileName/
expectedSize) — no TL object to re-issue a download with — and
redriveEnqueuedJob rebuilds the message via MessagesStorage.getMessage,
which for an edit pin returns the NEW message, not the old media. So
a freeze pin whose old media was still downloading when the process
died was doomed to FAILED after three restarts without ever
re-attempting the download, delaying the deferred-delete release by
up to three restarts. Fix: in the startup PINNED branch, when the
source is absent, transition directly to UNAVAILABLE with the new
distinct reason REASON_NO_PIN_SOURCE (SOURCE_GONE would be misleading
— the source never existed on disk) and release its deferred deletes
immediately, instead of burning attempts. Old-media re-download after
restart stays out of v1 scope (R-08). Source-present PINNED rows are
still re-driven to copy, unchanged.
---
 .../ayugram/aligram/AliGramEligibility.java   |  8 +++++
 .../ayugram/aligram/AliGramPreservation.java  | 32 ++++++++++++-------
 2 files changed, 29 insertions(+), 11 deletions(-)

diff --git a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramEligibility.java b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramEligibility.java
index f339e4042..ac574dc00 100644
--- a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramEligibility.java
+++ b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramEligibility.java
@@ -408,6 +408,14 @@ public final class AliGramEligibility {
     public static final String REASON_ANCHOR_LOST = "ANCHOR_LOST";
     public static final String REASON_PRE_ACTIVATION_MEDIA = "PRE_ACTIVATION_MEDIA";
     public static final String REASON_NO_PIN_SITE = "NO_PIN_SITE";
+    /**
+     * Phase 3.1 (D-11): a PINNED freeze pin whose source never
+     * materialised and cannot be re-downloaded after a restart — the old
+     * TL object and the PendingLoad died with the process, and the
+     * re-drive rebuilds the NEW message, not the old media (R-08).
+     * Distinct from SOURCE_GONE (the source existed and vanished).
+     */
+    public static final String REASON_NO_PIN_SOURCE = "NO_PIN_SOURCE";
     public static final String REASON_EDIT_DATE_UNKNOWN = "EDIT_DATE_UNKNOWN";
 
     // ------------------------------------------------------------------
diff --git a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramPreservation.java b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramPreservation.java
index 4975e018e..72b4074a2 100644
--- a/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramPreservation.java
+++ b/TMessagesProj/src/main/java/com/radolyn/ayugram/aligram/AliGramPreservation.java
@@ -2648,7 +2648,10 @@ public final class AliGramPreservation {
             FileLog.e(TAG + ": fakeId verification failed", e);
         }
         // 4. Reset DOWNLOADING/COPYING → ENQUEUED after gate re-check;
-        //    re-drive PINNED rows; attempts budget bounds stuck pins.
+        //    re-drive PINNED rows whose source is on disk; PINNED rows
+        //    with no source go straight to UNAVAILABLE (D-11 — they can
+        //    never be re-downloaded after a restart, so the attempts
+        //    budget is not burned on them).
         try {
             long userId = ownUserId(account);
             for (PreservedRef ref : dao.getNonTerminalRefs()) {
@@ -2684,16 +2687,23 @@ public final class AliGramPreservation {
                             }
                         });
                     } else {
-                        ref.attempts++;
-                        if (AliGramEligibility.attemptsExhausted(ref.attempts)) {
-                            ref.state = AliGramEligibility.STATE_FAILED;
-                            ref.lastError = AliGramEligibility.REASON_SOURCE_GONE;
-                            dao.updateRef(ref);
-                            mirrorRemoveForRef(ref);
-                            releaseDeferredDeletesForRef(account, ref.refId);
-                        } else {
-                            dao.updateRef(ref);
-                        }
+                        // Phase 3.1 (D-11): a PINNED row whose source
+                        // never materialised cannot be re-downloaded
+                        // after a restart — the old TL object and the
+                        // PendingLoad are gone with the process, and
+                        // redriveEnqueuedJob rebuilds the NEW message,
+                        // not the old media (R-08: old-media re-download
+                        // after restart is out of v1 scope). Do NOT burn
+                        // the attempts budget over three restarts: go
+                        // straight to UNAVAILABLE (not FAILED) with the
+                        // distinct NO_PIN_SOURCE reason, and release its
+                        // deferred deletes now.
+                        ref.state = AliGramEligibility.STATE_UNAVAILABLE;
+                        ref.lastError = AliGramEligibility.REASON_NO_PIN_SOURCE;
+                        ref.updatedAt = System.currentTimeMillis() / 1000;
+                        dao.updateRef(ref);
+                        mirrorRemoveForRef(ref);
+                        releaseDeferredDeletesForRef(account, ref.refId);
                     }
                 } else if (AliGramEligibility.STATE_ENQUEUED.equals(ref.state)) {
                     redriveEnqueuedJob(account, ref);
