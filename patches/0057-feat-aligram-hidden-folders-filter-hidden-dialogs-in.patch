 .../java/org/telegram/ui/Adapters/SearchAdapterHelper.java   | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Adapters/SearchAdapterHelper.java b/TMessagesProj/src/main/java/org/telegram/ui/Adapters/SearchAdapterHelper.java
index 5cb72231e..818bd7e8f 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Adapters/SearchAdapterHelper.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Adapters/SearchAdapterHelper.java
@@ -289,7 +289,10 @@ public class SearchAdapterHelper {
                 if (user == null) {
                     continue;
                 }
-                if (user.phone != null && user.phone.startsWith(phone)) {
+                // --- AliGram hidden folders: phone search is another
+                // server-merge surface; the per-adapter filter() override
+                // (DialogsSearchAdapter) drops hidden dialogs here.
+                if (user.phone != null && user.phone.startsWith(phone) && filter(user)) {
                     if (!hasFullMatch) {
                         hasFullMatch = user.phone.length() == phone.length();
                     }
