From b4358ec60e2125b13b030d056f1d4039ca411b1e Mon Sep 17 00:00:00 2001
From: tedfoagen-stack <tedfoagen@gmail.com>
Date: Sat, 21 Nov 2026 18:47:33 +0300
Subject: [PATCH 67/67] fix(aligram): capture final copy of stats for lambda in
 loadAliGramPreservedSize (not effectively final)

---
 .../nekogram/settings/NekoExperimentalSettingsActivity.java  | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/tw/nekomimi/nekogram/settings/NekoExperimentalSettingsActivity.java b/TMessagesProj/src/main/java/tw/nekomimi/nekogram/settings/NekoExperimentalSettingsActivity.java
index c2212be6f..60e29a2f0 100644
--- a/TMessagesProj/src/main/java/tw/nekomimi/nekogram/settings/NekoExperimentalSettingsActivity.java
+++ b/TMessagesProj/src/main/java/tw/nekomimi/nekogram/settings/NekoExperimentalSettingsActivity.java
@@ -668,7 +668,10 @@ public class NekoExperimentalSettingsActivity extends BaseNekoXSettingsActivity
                 }
                 stats = AliGramHiddenFolders.filterPreservedStats(stats, perDialog, hidden);
             }
-            AndroidUtilities.runOnUIThread(() -> refreshAliGramPreservedSize(stats), 500);
+            // stats is reassigned above when filtering, so it is not
+            // effectively final — capture a final copy for the lambda.
+            final long[] displayStats = stats;
+            AndroidUtilities.runOnUIThread(() -> refreshAliGramPreservedSize(displayStats), 500);
         });
     }
 
